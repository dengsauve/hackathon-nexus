{
    "compilerOptions": {
        "allowJs": false,
        "lib": ["DOM", "ESNext"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmit": true,
        "strict": true,
        "target": "ES2022",
        "types": ["node", "vite/client"]
    },
    "include": ["resources/js/**/*.ts", "vite.config.ts"]
}
